# Chave da Riot API (https://developer.riotgames.com). Sem ela o site roda em modo demonstração.
RIOT_API_KEY=

# Servidor da liga (br1, na1, euw1, kr, ...) e região de roteamento das partidas (americas, europe, asia, sea)
RIOT_PLATFORM=br1
RIOT_REGION=americas

# challenger | grandmaster | master
RIOT_LEAGUE=challenger

# Volume de coleta por atualização (respeite o rate limit da sua chave)
RIOT_PLAYERS=20
RIOT_MATCHES_PER_PLAYER=5
RIOT_MAX_NEW_MATCHES=60

# Intervalo de atualização dos dados da Riot, em segundos
REFRESH_SECONDS=300

# Limites da chave (padrão = chave de desenvolvimento)
RIOT_RATE_PER_SEC=20
RIOT_RATE_PER_2MIN=100
